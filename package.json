{
  "name": "enterprise-ppm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ppm/web",
    "build": "npm run build --workspace @ppm/web",
    "start": "npm run start --workspace @ppm/web",
    "lint": "eslint apps/web packages/contracts/src tests/browser",
    "typecheck": "npm run typecheck --workspace @ppm/web",
    "format": "prettier --write apps/web packages/contracts/src tests/browser package.json",
    "format:check": "prettier --check apps/web packages/contracts/src tests/browser package.json",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
