# Documentation only. Run scripts/bootstrap.py to generate .env with random local passwords.
PPM_POSTGRES_PASSWORD=replace-with-random-local-password
PPM_OWNER_PASSWORD=replace-with-random-local-password
PPM_APP_PASSWORD=replace-with-random-local-password
PPM_WEB_PORT=3000
PPM_API_PORT=8000
PPM_POSTGRES_PORT=15432
PPM_REDIS_PORT=16379
PPM_JWT_SECRET=replace-with-random-at-least-32-byte-key
PPM_WEB_ORIGIN=http://localhost:3000

# Account delivery: local private preview by default; no inbox mail is sent.
# For real sending, set smtp and supply a verified sender and provider credentials
# privately in the ignored .env. See docs/07-setup-and-deployment/EMAIL-DELIVERY.md.
# SMTP requires STARTTLS (usually port 587); implicit TLS port 465 is unsupported.
# User and password must both be set, or both blank for an authorized relay.
# PPM_WEB_ORIGIN must be reachable by recipients; localhost links work only on this PC.
PPM_MAIL_MODE=local
PPM_SMTP_HOST=
PPM_SMTP_PORT=587
PPM_SMTP_USER=
PPM_SMTP_PASSWORD=
PPM_MAIL_SENDER=
